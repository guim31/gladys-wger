{
  "manifest_version": 1,
  "type": "device",
  "name": "wger",
  "description": {
    "en": "wger in Gladys: weight and trend, workouts of the week, weigh-ins added from a scene.",
    "fr": "wger dans Gladys : poids et tendance, séances de la semaine, pesées ajoutées depuis une scène.",
    "de": "wger in Gladys: Gewicht und Trend, Trainings der Woche, Wägungen per Szene hinzufügen.",
    "es": "wger en Gladys: peso y tendencia, sesiones de la semana, pesajes añadidos desde una escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-wger:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-wger/main/cover.png",
  "categories": ["services"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Gladys reads your wger account (wger.de or your own server) with its API key: weight, workouts, calories. One device in the Discovery tab. Health data: no history by default, never in the logs.",
        "fr": "Gladys lit votre compte wger (wger.de ou votre serveur) avec sa clé API : poids, séances, calories. Un appareil dans l'onglet Découverte. Données de santé : pas d'historique par défaut, rien dans les logs.",
        "de": "Gladys liest dein wger-Konto (wger.de oder dein eigener Server) mit seinem API-Schlüssel: Gewicht, Trainings, Kalorien. Ein Gerät im Tab „Entdecken“. Gesundheitsdaten: standardmäßig ohne Verlauf, nie in den Protokollen.",
        "es": "Gladys lee su cuenta wger (wger.de o su propio servidor) con su clave API: peso, sesiones, calorías. Un dispositivo en la pestaña Descubrir. Datos de salud: sin historial por defecto, nunca en los registros."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-wger/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://wger.de/en/user/api-key",
          "label": {
            "en": "API key on wger.de",
            "fr": "Clé API sur wger.de",
            "de": "API-Schlüssel auf wger.de",
            "es": "Clave API en wger.de"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "wger address",
        "fr": "Adresse de wger",
        "de": "wger-Adresse",
        "es": "Dirección de wger"
      },
      "description": {
        "en": "https://wger.de, or the address of your own server.",
        "fr": "https://wger.de, ou l'adresse de votre propre serveur.",
        "de": "https://wger.de oder die Adresse deines eigenen Servers.",
        "es": "https://wger.de, o la dirección de su propio servidor."
      },
      "placeholder": {
        "en": "e.g. https://wger.de",
        "fr": "ex. https://wger.de",
        "de": "z. B. https://wger.de",
        "es": "p. ej. https://wger.de"
      },
      "required": true,
      "default": "https://wger.de"
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé API",
        "de": "API-Schlüssel",
        "es": "Clave API"
      },
      "description": {
        "en": "In wger: user menu, API key (Generate a new key).",
        "fr": "Dans wger : menu utilisateur, Clé API (générer une nouvelle clé).",
        "de": "In wger: Benutzermenü, API-Schlüssel (neuen Schlüssel erzeugen).",
        "es": "En wger: menú de usuario, Clave API (generar una nueva clave)."
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often wger is read. A weigh-in added from a scene is read at once.",
        "fr": "À quelle fréquence wger est lu. Une pesée ajoutée par une scène est relue tout de suite.",
        "de": "Wie oft wger gelesen wird. Eine per Szene hinzugefügte Wägung wird sofort gelesen.",
        "es": "Con qué frecuencia se lee wger. Un pesaje añadido desde una escena se lee al momento."
      },
      "required": true,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when the device is added) and of the texts sent to scenes.",
        "fr": "Langue des noms de fonctionnalités (figés à l'ajout de l'appareil) et des textes envoyés aux scènes.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen des Geräts festgelegt) und der Texte für Szenen.",
        "es": "Idioma de los nombres de funciones (fijados al añadir el dispositivo) y de los textos enviados a las escenas."
      },
      "default": "fr",
      "required": true,
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
