          "placeholder": {
            "en": "e.g. 2026-10-22",
            "fr": "ex. 2026-10-22",
            "de": "z. B. 2026-10-22",
            "es": "p. ej. 2026-10-22"
          }
        },
        {
          "key": "check_change",
          "type": "boolean",
          "required": false,
          "default": true,
          "label": {
            "en": "Refuse more than 10 % from the last weigh-in",
            "fr": "Refuser plus de 10 % d'écart avec la dernière pesée",
            "de": "Über 10 % Abweichung zur letzten Wägung ablehnen",
            "es": "Rechazar más de un 10 % de diferencia con el último pesaje"
          }
        }
      ],
