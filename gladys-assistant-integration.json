  "scene_actions": [
    {
      "key": "add_weight",
      "label": {
        "en": "Add a weigh-in",
        "fr": "Ajouter une pesée",
        "de": "Wägung hinzufügen",
        "es": "Añadir un pesaje"
      },
      "description": {
        "en": "Adds a weight to wger, e.g. from a connected scale. Refuses implausible values.",
        "fr": "Ajoute un poids dans wger, par exemple d'une balance connectée. Refuse les valeurs aberrantes.",
        "de": "Fügt in wger ein Gewicht hinzu, z. B. von einer vernetzten Waage. Lehnt unplausible Werte ab.",
        "es": "Añade un peso en wger, p. ej. de una báscula conectada. Rechaza los valores aberrantes."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "weight",
          "type": "string",
          "required": true,
          "label": {
            "en": "Weight (unit of the wger profile)",
            "fr": "Poids (unité du profil wger)",
            "de": "Gewicht (Einheit des wger-Profils)",
            "es": "Peso (unidad del perfil wger)"
          },
          "description": {
            "en": "A number like 79.8, or a scene value, e.g. the weight of your scale.",
            "fr": "Un nombre comme 79,8, ou une valeur de la scène, ex. le poids de votre balance.",
            "de": "Eine Zahl wie 79,8 oder ein Wert der Szene, z. B. das Gewicht deiner Waage.",
            "es": "Un número como 79,8, o un valor de la escena, p. ej. el peso de su báscula."
